# ---------------------------------------------------------------------------
# field-ops-offline-sync — API environment template.
# Copy to `.env` at the repository root. `.env` is git-ignored.
# Every value below is a placeholder; none of them is a working credential.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=field_ops
DB_USER=field_ops_app
DB_PASS=change-me
DB_CHARSET=utf8mb4

# --- Application ----------------------------------------------------------
# "local" prints exception messages in the JSON error envelope.
# Anything else (staging, production) returns a generic message and logs
# the detail to APP_LOG_FILE instead.
APP_ENV=local
APP_LOG_FILE=api/storage/logs/api.log

# --- Tokens ---------------------------------------------------------------
# Sliding lifetime of a device token, in days. Every authenticated request
# may extend it, but never beyond TOKEN_ABSOLUTE_DAYS from its creation.
TOKEN_TTL_DAYS=30
TOKEN_ABSOLUTE_DAYS=90

# --- Login throttling -----------------------------------------------------
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# --- Sync -----------------------------------------------------------------
# Safety overlap subtracted from the delta cursor handed back to clients.
# It must exceed the longest write transaction, otherwise a row committed
# late can fall behind the cursor and never be delivered.
# See docs/architecture.md, "The delta cursor race".
SYNC_CURSOR_OVERLAP_SECONDS=5
# Maximum rows returned per entity in a single /sync/pull page.
SYNC_PAGE_LIMIT=500
# Maximum operations accepted in one /sync/push batch.
SYNC_PUSH_MAX_OPERATIONS=100

# --- Uploads --------------------------------------------------------------
# Directory for inspection photos. Keep it outside the web root.
UPLOAD_DIR=api/storage/uploads
UPLOAD_MAX_BYTES=8388608

# --- CORS -----------------------------------------------------------------
# Comma-separated origin allow-list for browser clients. The native app does
# not send an Origin header and is unaffected. Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
